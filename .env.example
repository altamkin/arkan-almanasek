# =============================================================================
# Build-time (NEXT_PUBLIC_*, baked into the client bundle)
# Pass these via docker compose build.args / Dockerfile ARG before `next build`.
# Changing any of these requires a rebuild — runtime-only .env updates will not
# update values already inlined into browser JS.
# =============================================================================

# Public API base URL used by client + server fetch helpers (e.g. https://api.example.com/api/v1)
NEXT_PUBLIC_API_BASE_URL=

# =============================================================================
# Runtime only (server-side, read after boot)
# Safe to set via env_file / orchestrator secrets; not baked into the client.
# =============================================================================

# Listen port inside the container (must match docker-compose expose + nginx upstream)
PORT=3000

# Bind address for the standalone Next.js server (required for Docker networking)
HOSTNAME=0.0.0.0

# production | development | test
NODE_ENV=production
